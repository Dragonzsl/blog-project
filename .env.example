BLOG_SITE_ADDRESS=https://localhost
BLOG_DATA_DIR=/data/site
BLOG_LOG_LEVEL=info
BLOG_LOG_FORMAT=json
BLOG_MEMORY_LIMIT=640MiB
# Optional: set a random value of at least 32 bytes; otherwise the app creates
# /data/secrets/auth.key with mode 0600 on first start.
BLOG_AUTH_SECRET=
BLOG_STORAGE_ADAPTER=local
# BLOG_S3_ENDPOINT=https://s3.example.com
# BLOG_S3_BUCKET=
# BLOG_S3_REGION=us-east-1
# BLOG_S3_ACCESS_KEY=
# BLOG_S3_SECRET_KEY=
# BLOG_ANALYTICS_ENABLED=false
# BLOG_COMMENTS_ENABLED=false
