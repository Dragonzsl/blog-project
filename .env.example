BLOG_SITE_ADDRESS=https://localhost
BLOG_DATA_DIR=/data/site
BLOG_LOG_LEVEL=info
BLOG_LOG_FORMAT=json
# Keep the Go heap soft limit below the app's 256 MiB cgroup budget.
BLOG_MEMORY_LIMIT=192MiB
# Optional: set a random value of at least 32 bytes; otherwise the app creates
# /data/secrets/auth.key with mode 0600 on first start.
BLOG_AUTH_SECRET=
BLOG_STORAGE_ADAPTER=local
# BLOG_S3_ENDPOINT=https://s3.example.com
# BLOG_S3_BUCKET=
# BLOG_S3_REGION=us-east-1
# BLOG_S3_ACCESS_KEY=
# BLOG_S3_SECRET_KEY=
# BLOG_ANALYTICS_ENABLED=false
# BLOG_COMMENTS_ENABLED=false
# BLOG_COMMENTS_EXTERNAL_ENDPOINT=https://comments.example.com/thread
# BLOG_MAIL_ENABLED=false
# BLOG_MAIL_HOST=smtp.example.com
# BLOG_MAIL_PORT=587
# BLOG_MAIL_USERNAME=
# BLOG_MAIL_PASSWORD=
# BLOG_MAIL_FROM=owner@example.com
# BLOG_NEWSLETTER_PROVIDER=disabled
# BLOG_NEWSLETTER_ENDPOINT=https://newsletter.example.com/subscribers
# BLOG_NEWSLETTER_TOKEN=
# BLOG_CONTENT_API_ENABLED=false
# BLOG_CONTENT_API_TOKEN=
# BLOG_WEBHOOKS_ENABLED=false
# BLOG_WEBHOOK_ENDPOINT=https://hooks.example.com/blog
# BLOG_WEBHOOK_SECRET=
# BLOG_WEBHOOK_MAX_ATTEMPTS=5
